  "comparisons": [
    {
      "id": "haiku-vs-composer",
      "models": [
        "haiku",
        "composer-2.5"
      ],
      "summary": "Both are cheap recon/verify tiers. Pick by platform and whether the task needs shell + edits.",
      "choose_first_when": {
        "haiku": [
          "Session is in Claude Code",
          "Read-only scout: grep, read excerpts, file:line summaries",
          "Pure lookup with minimal tokens"
        ],
        "composer-2.5": [
          "Session is in Cursor (subagents run here)",
          "Verifier must run tests, scripts, or linters",
          "Mechanical edits or multi-step tool loops in one pass",
          "Chief is Grok/Sol/Claude but work happens in Cursor"
        ]
      },
      "either_fine_when": [
        "Summarizing an already-located code path",
        "Checklist verification against a written plan with no commands"
      ],
      "note": "Composer is not smarter than Haiku for lookup — it has Cursor agent tooling. Haiku is not weaker — it is the right cheap tier inside Claude Code, where Composer is not spawnable."
    },
    {
      "id": "sonnet-vs-composer",
      "models": [
        "sonnet",
        "composer-2.5"
      ],
      "summary": "Mid execution band. Sonnet in Claude Code; Composer in Cursor with shell access.",
      "choose_first_when": {
        "sonnet": [
          "Implementing in Claude Code with judgment within scoped files",
          "Claude-native mech-executor role"
        ],
        "composer-2.5": [
          "Implementing in Cursor with command verification",
          "Fixture generation, test runs, or repo scripts in the same turn"
        ]
      },
      "either_fine_when": [
        "Small scoped fix following an existing pattern when the platform is already chosen"
      ]
    },
    {
      "id": "opus-vs-terra",
      "models": [
        "opus",
        "terra"
      ],
      "summary": "Heavy delegated implementation. Cross-family; pick whichever is available on the active platform.",
      "choose_first_when": {
        "opus": [
          "Claude Code executor or security-executor",
          "Security-sensitive or architecture-review slices",
          "Cursor work that needs the strongest reasoning (claude-opus-5-thinking-high)"
        ],
        "terra": [
          "Cursor subagent for hard implementation at lower cost than a frontier chief",
          "Chief is Grok or Sol and inherit would burn frontier tokens"
        ]
      },
      "either_fine_when": [
        "Complex multi-file debugging when either ID is pinned in subagent frontmatter"
      ]
    }
  ],
  "role_hints": {
    "scout": {
      "claude": "haiku",
      "cursor": "composer-2.5",
      "why": "Read-only recon; cheapest model with the right platform toolchain."
    },
    "mech-executor": {
      "claude": "sonnet",
      "cursor": "composer-2.5",
      "why": "Fully specified work; no architecture calls."
    },
    "executor": {
      "claude": "opus",
      "cursor": "terra",
      "cursor_alternate": "opus",
      "why": "Judgment-heavy implementation without inheriting the chief session."
    },
    "verifier": {
      "claude": "sonnet",
      "cursor": "composer-2.5",
      "why": "Run checks and report PASS/FAIL; Composer when commands are required."
    },
    "security-executor": {
      "claude": "opus",
      "cursor": "inherit",
      "why": "Never lightweight; chief decides, heavy model reviews."
    },
    "chief": {
      "options": [
        "fable",
        "opus",
        "grok",
        "sol"
      ],
      "why": "Intent, adversarial review, tradeoffs, final synthesis only."
    }
  }
